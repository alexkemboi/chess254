{
  "name": "chess254-clubhouse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src prisma tests",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:demo:remove": "tsx prisma/seed-demo.ts --remove",
    "test": "node tests/run.mjs",
    "test:integration": "node tests/run.mjs --only=integration",
    "test:e2e": "node tests/run.mjs --only=e2e",
    "mock:daraja": "node tests/mock-daraja.mjs",
    "cron": "node -e \"fetch((process.env.NEXT_PUBLIC_APP_URL||'http://localhost:3000')+'/api/cron',{headers:{authorization:'Bearer '+process.env.CRON_SECRET}}).then(r=>r.text()).then(console.log)\""
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.4.0",
    "nodemailer": "^7.0.13",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.4.0",
    "playwright": "^1.64.0",
    "prisma": "^6.16.2",
    "smtp-server": "^3.19.18",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
