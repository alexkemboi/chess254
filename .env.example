# ─── Core ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/chess254?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/chess254?schema=public"
# Public origin. Use https:// in production (enables HSTS + upgrade-insecure-requests).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Long random strings (e.g. `openssl rand -base64 48`). Never reuse between environments.
AUTH_SECRET=""
# Signs the secret path segment of payment callback URLs. Rotating it invalidates old callback URLs.
WEBHOOK_SECRET=""
# AES-256-GCM key for credentials saved from the admin UI. Without it, credentials must come from env vars.
SETTINGS_ENCRYPTION_KEY=""
# Bearer token for the scheduled job: GET /api/cron with "Authorization: Bearer $CRON_SECRET" every ~5 min.
CRON_SECRET=""

# ─── Initial administrator (used by `npm run db:seed`) ────────────────────
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_NAME="Club administrator"
INITIAL_ADMIN_PASSWORD=""

# ─── M-Pesa (Safaricom Daraja) ────────────────────────────────────────────
# Env values override the admin Payment settings and lock those fields in the UI.
MPESA_ENVIRONMENT="sandbox"            # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""
# Public HTTPS origin Safaricom can reach; the secret callback path is appended automatically.
MPESA_CALLBACK_URL=""
# Test harness only — points the provider at tests/mock-daraja.mjs. Leave empty in real deployments.
MPESA_API_BASE_URL=""

# ─── Email (SMTP) ─────────────────────────────────────────────────────────
# Without SMTP, emails are skipped and (outside production) printed to the server log.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# ─── Storage ──────────────────────────────────────────────────────────────
# Uploads are stored in PostgreSQL and served from /media/[id] by default.
# These are reserved for an object-storage driver (src/server/storage.ts).
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# ─── Demo content (local preview only) ────────────────────────────────────
# Shared password for demo accounts created by `npm run db:seed:demo`. Leave empty to make them unable to sign in.
DEMO_PASSWORD=""
